{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window, the detached screen and the detached panels (RP22)",
  "windows": [
    "main",
    "pantalla",
    "panel-*"
  ],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "opener:default",
    "dialog:default"
  ]
}

# Compila EmuRV para Linux x86_64 (AppImage) desde macOS via Docker.
# Multi-stage: el stage `export` deja SOLO el .AppImage para sacarlo con
#   docker build --platform linux/amd64 -f Dockerfile.linux \
#       --target export --output type=local,dest=linux-dist .
# En un host arm64 (Apple Silicon) corre emulado (qemu) -> lento pero funciona.

FROM --platform=linux/amd64 ubuntu:22.04 AS builder
ENV DEBIAN_FRONTEND=noninteractive

# Dependencias de build de Tauri 2 en Linux + CMake (Unicorn se compila con CMake).
RUN apt-get update && apt-get install -y --no-install-recommends \
      curl wget file ca-certificates git xdg-utils patchelf \
      libfuse2 desktop-file-utils \
      build-essential pkg-config cmake ninja-build \
      clang libclang-dev \
      libwebkit2gtk-4.1-dev libgtk-3-dev librsvg2-dev \
      libayatana-appindicator3-dev libsoup-3.0-dev libssl-dev \
      libgtk-3-bin libgdk-pixbuf2.0-bin librsvg2-common \
      libglib2.0-bin gsettings-desktop-schemas \
    && rm -rf /var/lib/apt/lists/*

# Rust stable (perfil mínimo).
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal
ENV PATH="/root/.cargo/bin:${PATH}"
# rustfmt: el build de unicorn-engine-sys lo invoca para formatear el FFI generado.
RUN rustup component add rustfmt

# Node 20 LTS.
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY . .

# node_modules de Linux (esbuild y demás binarios nativos son por-plataforma).
RUN npm ci

# Compilar el binario por separado: esta capa (la pesada: Unicorn + Tauri) se
# cachea, así iterar sobre el empaquetado no recompila todo.
RUN cargo build --release --manifest-path src-tauri/Cargo.toml

# AppImage en contenedor: sin FUSE, extraer-y-correr linuxdeploy/appimagetool.
ENV APPIMAGE_EXTRACT_AND_RUN=1

# .deb primero (red de seguridad: NO usa linuxdeploy, casi siempre compila).
RUN npx tauri build --bundles deb --verbose
# AppImage después, TOLERANTE: si linuxdeploy falla, el .deb igual queda.
RUN npx tauri build --bundles appimage --verbose || echo "AppImage FALLO — sigo con .deb"
# Juntar lo que haya salido en /out.
RUN mkdir -p /out \
    && cp src-tauri/target/release/bundle/deb/*.deb /out/ \
    && (cp src-tauri/target/release/bundle/appimage/*.AppImage /out/ 2>/dev/null || true) \
    && ls -la /out

# Stage de salida: lo que haya en /out (.deb seguro, AppImage si salió).
FROM scratch AS export
COPY --from=builder /out/ /
